# OpenWeatherMap API
OPENWEATHER_API_KEY=your_api_key_here

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=weather_stream
KAFKA_CONSUMER_GROUP=weather_consumer_group

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weather_streaming
POSTGRES_USER=streaming_user
POSTGRES_PASSWORD=streaming_pass

# Logging
LOG_LEVEL=INFO